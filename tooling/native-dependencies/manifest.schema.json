{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_path": {
      "type": "string",
      "pattern": "^third_party/native/[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
          },
          "upstream": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "origin": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "git"
                      },
                      "url": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      }
                    },
                    "required": [
                      "kind",
                      "url",
                      "revision"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "registry"
                      },
                      "url": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "kind",
                      "url",
                      "name",
                      "version",
                      "sha256"
                    ]
                  }
                ]
              },
              "archive": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "strip_prefix": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tree_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "origin",
              "archive",
              "sha256",
              "strip_prefix",
              "tree_sha256"
            ]
          },
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            }
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "manifest": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                },
                "license_files": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
                      },
                      "role": {
                        "enum": [
                          "license",
                          "notice",
                          "additional"
                        ]
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "origin": {
                        "type": "string",
                        "pattern": "^(upstream|https://.+)$"
                      }
                    },
                    "required": [
                      "path",
                      "role",
                      "sha256",
                      "origin"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "version",
                "manifest",
                "license",
                "license_files"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "path",
          "upstream",
          "patches",
          "packages"
        ]
      },
      "minItems": 1
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "directory"
              }
            },
            "required": [
              "kind"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "file"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "executable": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "sha256",
              "bytes",
              "executable"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "symlink"
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "target"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "artifact_sha256",
    "artifact_path",
    "sources",
    "files"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installed native dependency artifact manifest"
}
