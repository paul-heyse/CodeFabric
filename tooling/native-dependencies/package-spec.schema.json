{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "upstream": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "git"
                  },
                  "repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                },
                "required": [
                  "kind",
                  "repository",
                  "url",
                  "revision"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "registry"
                  },
                  "archive": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "archive",
                  "url",
                  "name",
                  "version",
                  "sha256"
                ]
              }
            ]
          },
          "staged_path": {
            "type": "string",
            "minLength": 1
          },
          "patches": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "manifest": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                },
                "license_files": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
                      },
                      "role": {
                        "enum": [
                          "license",
                          "notice",
                          "additional"
                        ]
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "origin": {
                        "type": "string",
                        "pattern": "^(upstream|https://.+)$"
                      }
                    },
                    "required": [
                      "path",
                      "role",
                      "sha256",
                      "origin"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "version",
                "manifest",
                "license",
                "license_files"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "upstream",
          "staged_path",
          "patches",
          "packages"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "sources"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native dependency packaging input"
}
