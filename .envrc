# direnv environment for CodeFabric.
#
# Applies when you cd into the repo in an interactive shell. Agents and other
# non-interactive callers do not get this automatically -- see scripts/bootstrap.sh
# and the "Environment" section of CLAUDE.md.
#
# Activate once with:  direnv allow

# Re-evaluate when the Python dependency set changes.
watch_file pyproject.toml uv.lock

# Re-evaluate when the Rust toolchain pin appears or changes (neither exists yet;
# watch_file tolerates missing paths and will fire when they are created).
watch_file rust-toolchain.toml Cargo.toml

export UV_PROJECT_ENVIRONMENT="${PWD}/.venv"

# Materialise the venv. Idempotent and near-instant when already in sync.
# Non-fatal: a missing uv or a resolution failure should not make the directory
# unenterable, so report and continue with whatever venv already exists.
if has uv; then
  uv sync --quiet || log_status "uv sync failed; .venv may be stale"
else
  log_status "uv not found on PATH; skipping sync"
fi

if [ -d "${UV_PROJECT_ENVIRONMENT}/bin" ]; then
  export VIRTUAL_ENV="${UV_PROJECT_ENVIRONMENT}"
  PATH_add "${VIRTUAL_ENV}/bin"
else
  log_status ".venv not present; run 'uv sync'"
fi

# Repo-local scripts (bootstrap.sh and anything added later) callable by name.
PATH_add "${PWD}/scripts"

# ---------------------------------------------------------------------------
# FastMCP serving layer configuration
#
# The serving spec's Settings class sets env_file=None, so configuration comes
# from real environment variables rather than a .env file -- which makes this
# the right place for them. Three have no default and are required once the
# daemon exists; they are left unset deliberately, because a bogus daemon
# target fails later and more confusingly than an absent one.
#
#   export CODEFABRIC_CPG_DAEMON_TARGET="unix:///tmp/codefabric-<workspace>.sock"
#   export CODEFABRIC_WORKSPACE_ID="..."
#   export CODEFABRIC_CPG_CAPABILITY_TOKEN="..."   # secret -- see below
#
# Optional, all defaulted: CODEFABRIC_AGENT_INSTANCE_ID,
# CODEFABRIC_CPG_QUERY_TIMEOUT_SECONDS, CODEFABRIC_CPG_INLINE_RESULT_BYTES,
# CODEFABRIC_CPG_MAX_REQUEST_BYTES, CODEFABRIC_CPG_LOG_LEVEL, and others listed
# in present_state_cpg_fastmcp_serving_specification_v1.1.md.
#
# The capability token is a secret and must never be committed. Put it in
# .envrc.local, which is gitignored.
# ---------------------------------------------------------------------------

if [ -f "${PWD}/.envrc.local" ]; then
  source_env "${PWD}/.envrc.local"
fi
