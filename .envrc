# direnv environment for CodeFabric.
#
# Applies lightweight repository paths to an interactive shell. Repository recipes are
# independently self-contained and do not require direnv.
#
# Activate once with:  direnv allow

# Re-evaluate when any build-domain lock or toolchain contract changes.
watch_file rust-toolchain.toml Cargo.toml Cargo.lock
watch_file rustc-extractor/rust-toolchain.toml rustc-extractor/Cargo.lock
watch_file pyrefly-sidecar/Cargo.lock
watch_file codefabric-cpg-mcp/.python-version codefabric-cpg-mcp/pyproject.toml codefabric-cpg-mcp/uv.lock

export CF_ROOT="${PWD}"
export UV_CACHE_DIR="${PWD}/target/uv-cache"

# Homebrew's shell initialization can otherwise put its standalone cargo/rustc ahead of
# Rustup. The repository Cargo router then selects stable or the dated extractor nightly.
PATH_add "${HOME}/.cargo/bin"
PATH_add "${PWD}/scripts"

# ---------------------------------------------------------------------------
# FastMCP adapter configuration
#
# The adapter is a separate Python build domain. Its Settings class uses real
# environment variables rather than dotenv files, so `.envrc.local` remains the
# workstation-only location for secrets.
#
#   export CODEFABRIC_CPG_DAEMON_TARGET="unix:///tmp/codefabric-<workspace>.sock"
#   export CODEFABRIC_WORKSPACE_ID="..."
#   export CODEFABRIC_CPG_CAPABILITY_TOKEN="..."   # secret -- see below
#
# Optional, all defaulted: CODEFABRIC_AGENT_INSTANCE_ID,
# CODEFABRIC_CPG_QUERY_TIMEOUT_SECONDS, CODEFABRIC_CPG_INLINE_RESULT_BYTES,
# CODEFABRIC_CPG_MAX_REQUEST_BYTES, CODEFABRIC_CPG_LOG_LEVEL, and others listed
# in present_state_cpg_fastmcp_serving_specification_v1.3.md.
#
# The capability token is a secret and must never be committed. Put it in
# .envrc.local, which is gitignored.
# ---------------------------------------------------------------------------

if [ -f "${PWD}/.envrc.local" ]; then
  source_env "${PWD}/.envrc.local"
fi
