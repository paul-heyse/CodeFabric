{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefabric.dev/contracts/manifests/deployment-profile.schema.json",
  "title": "CodeFabric local workstation deployment profile 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id", "artifact_kind", "version", "compatible_suite_major", "status",
    "canonical_digest", "digest_projection", "generator_revision", "profile_id",
    "supported_platforms", "windows_support", "network_listeners",
    "workspace_registration", "operational_store", "fact_store", "object_store",
    "hot_overlay_journal", "source_blob_persistence", "result_artifact_ttl_seconds",
    "source_result_artifact_ttl_seconds", "default_query_freshness", "provider_sandbox",
    "follow_directory_symlinks", "follow_internal_file_symlinks",
    "index_external_dependency_bodies", "semantic_query_language", "canonical_json",
    "platform_roots"
  ],
  "properties": {
    "artifact_id": {"const": "codefabric.deployment.local-workstation-v1"},
    "artifact_kind": {"const": "yaml-contract"},
    "version": {"const": "1.0"},
    "compatible_suite_major": {"const": 1},
    "status": {"const": "released"},
    "canonical_digest": {"type": "string", "pattern": "^b3:[0-9a-f]{64}$"},
    "digest_projection": {"const": "yaml-ac-g-53-v1"},
    "generator_revision": {"const": "codefabric-contracts/1.0"},
    "profile_id": {"const": "local-workstation-v1"},
    "supported_platforms": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 4,
      "maxItems": 4,
      "items": {"enum": ["linux-x86_64", "linux-aarch64", "macos-aarch64", "macos-x86_64"]}
    },
    "windows_support": {"const": "unsupported"},
    "network_listeners": {"const": "disabled"},
    "workspace_registration": {"const": "explicit-only"},
    "operational_store": {"const": "sqlite-wal"},
    "fact_store": {"const": "delta-local-filesystem"},
    "object_store": {"const": "local-filesystem"},
    "hot_overlay_journal": {"const": "disabled"},
    "source_blob_persistence": {"const": "runtime-lease-only"},
    "result_artifact_ttl_seconds": {"const": 3600},
    "source_result_artifact_ttl_seconds": {"const": 1800},
    "default_query_freshness": {"const": "REQUIRE_CURRENT_FOR_TARGETS"},
    "provider_sandbox": {"const": "required-for-untrusted"},
    "follow_directory_symlinks": {"const": false},
    "follow_internal_file_symlinks": {"const": false},
    "index_external_dependency_bodies": {"const": false},
    "semantic_query_language": {"const": "english-controlled-v1"},
    "canonical_json": {"const": "rfc8785-plus-codefabric-v1"},
    "platform_roots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/platformRoot"}
    }
  },
  "$defs": {
    "platformRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_family", "state_root_options", "runtime_root_options", "config_root_options", "directory_mode", "private_file_mode"],
      "properties": {
        "platform_family": {"enum": ["linux", "macos"]},
        "state_root_options": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "runtime_root_options": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "config_root_options": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "directory_mode": {"const": "0700"},
        "private_file_mode": {"const": "0600"}
      }
    }
  },
  "x-codefabric-artifact": {
    "artifact_id": "codefabric.manifests.deployment-profile.schema",
    "artifact_kind": "json-schema",
    "version": "1.0",
    "compatible_suite_major": 1,
    "status": "released",
    "canonical_digest": "b3:9bf207a10a68dbebbcdaf70dc1ca2d0fa41b404b9ba442cf5322c2dfc1926315"
  }
}
