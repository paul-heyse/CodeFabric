{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefabric.dev/contracts/registry/model-pack.schema.json",
  "title": "CodeFabric declarative model pack",
  "description": "Closed, non-executable provider-model records for libraries whose source is unavailable.",
  "type": "object",
  "required": [
    "pack_id",
    "pack_version",
    "schema_version",
    "targets",
    "records",
    "fixtures",
    "pack_digest",
    "signature"
  ],
  "properties": {
    "pack_id": {"$ref": "#/$defs/reverse_dns_id"},
    "pack_version": {"$ref": "#/$defs/semantic_version"},
    "schema_version": {"const": "1.0"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/target"}
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model_record"}
    },
    "fixtures": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/fixture"},
      "allOf": [
        {"contains": {"properties": {"fixture_kind": {"const": "positive"}}}},
        {"contains": {"properties": {"fixture_kind": {"const": "negative"}}}},
        {"contains": {"properties": {"fixture_kind": {"const": "version-boundary"}}}}
      ]
    },
    "pack_digest": {"$ref": "#/$defs/blake3_digest"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "additionalProperties": false,
  "$defs": {
    "reverse_dns_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*){2,}$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "blake3_digest": {
      "type": "string",
      "pattern": "^b3:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{86}$"
    },
    "bounded_literal_pattern": {
      "description": "A literal qualified-name segment with at most one terminal wildcard; never a regular expression.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*(?:\\*)?$",
      "not": {"pattern": "[\\[\\]{}()+?|^$\\\\]"}
    },
    "target": {
      "type": "object",
      "required": ["ecosystem", "package", "version_requirement"],
      "properties": {
        "ecosystem": {"enum": ["python", "rust"]},
        "package": {"type": "string", "minLength": 1, "maxLength": 200},
        "version_requirement": {"type": "string", "minLength": 1, "maxLength": 100}
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "required": ["qualified_name"],
      "properties": {
        "qualified_name": {"$ref": "#/$defs/bounded_literal_pattern"},
        "member_name": {"$ref": "#/$defs/bounded_literal_pattern"},
        "parameter_count": {"type": "integer", "minimum": 0, "maximum": 255}
      },
      "additionalProperties": false
    },
    "semantics": {
      "type": "object",
      "required": ["summary", "effect_kinds", "resource_kinds"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "effect_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "resource_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        },
        "return_type": {"type": "string", "minLength": 1, "maxLength": 500},
        "raises": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source", "reviewed_by", "reviewed_at", "source_digest"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 500},
        "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 200},
        "reviewed_at": {"type": "string", "format": "date"},
        "source_digest": {"$ref": "#/$defs/blake3_digest"}
      },
      "additionalProperties": false
    },
    "model_record": {
      "type": "object",
      "required": [
        "record_id",
        "record_kind",
        "match",
        "semantics",
        "certainty",
        "closed_world_fields",
        "provenance"
      ],
      "properties": {
        "record_id": {"$ref": "#/$defs/reverse_dns_id"},
        "record_kind": {"enum": ["callable", "member", "type", "effect", "resource", "ffi-bridge"]},
        "match": {"$ref": "#/$defs/match"},
        "semantics": {"$ref": "#/$defs/semantics"},
        "certainty": {"const": "MODELLED"},
        "closed_world_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["effects", "resources", "return-type", "raises", "members", "call-targets"]}
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": ["fixture_id", "fixture_kind", "input", "expected_record_ids"],
      "properties": {
        "fixture_id": {"$ref": "#/$defs/reverse_dns_id"},
        "fixture_kind": {"enum": ["positive", "negative", "version-boundary"]},
        "input": {
          "type": "object",
          "required": ["target", "qualified_name"],
          "properties": {
            "target": {"$ref": "#/$defs/reverse_dns_id"},
            "qualified_name": {"type": "string", "minLength": 1, "maxLength": 500},
            "member_name": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "additionalProperties": false
        },
        "expected_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reverse_dns_id"}
        }
      },
      "additionalProperties": false
    }
  },
  "x-codefabric-artifact": {
    "artifact_id": "codefabric.registry.model-pack.schema",
    "artifact_kind": "json-schema",
    "version": "1.0",
    "compatible_suite_major": 1,
    "status": "released",
    "canonical_digest": "b3:425ef0f440c3a064af8026ab0a3ebde47dc2dbc490416d7ea8023cbe4c55260b"
  }
}
