{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefabric.local/contracts/relational-fabric-v3/successor-certification-record.schema.json",
  "title": "CodeFabric relational-fabric v3 successor certification record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "suite",
    "plan_path",
    "state_path",
    "trusted_head",
    "generated_at",
    "certification_state",
    "release_state",
    "scope",
    "immutable_inputs",
    "environment",
    "oracle_results",
    "limitations",
    "independent_review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "const": "codefabric-relational-data-fabric@2.1.0"
    },
    "plan_path": {
      "const": "docs/plans/codefabric_execution_proved_relational_data_fabric_implementation_plan_v3_2026-08-30.md"
    },
    "state_path": {
      "const": "docs/plans/state/codefabric-execution-proved-relational-data-fabric_v3_state.json"
    },
    "trusted_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "certification_state": {
      "enum": [
        "architecture_certified",
        "architecture_certified_profile_limited"
      ]
    },
    "release_state": {
      "enum": [
        "eligible",
        "blocked_by_unavailable_profile"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packets",
        "excluded_packets",
        "oracle_count",
        "required_milestones",
        "excluded_milestones",
        "required_decommission_batches"
      ],
      "properties": {
        "packets": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "excluded_packets": {
          "const": [
            "WP28"
          ]
        },
        "oracle_count": {
          "const": 56
        },
        "required_milestones": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "excluded_milestones": {
          "const": [
            "M01"
          ]
        },
        "required_decommission_batches": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "immutable_inputs": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "domains",
        "host_profiles"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "domains": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "host_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "availability",
              "admission",
              "architecture_effect"
            ],
            "properties": {
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "availability": {
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "admission": {
                "const": "fail_closed"
              },
              "architecture_effect": {
                "enum": [
                  "none",
                  "profile_unavailable"
                ]
              }
            }
          }
        }
      }
    },
    "oracle_results": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packet",
          "category",
          "criterion",
          "oracle",
          "command",
          "exit_code",
          "selected_test_count",
          "elapsed_ms",
          "resource_summary",
          "output_sha256"
        ],
        "properties": {
          "packet": {
            "type": "string"
          },
          "category": {
            "enum": [
              "INT",
              "BEH",
              "NEG",
              "OPS"
            ]
          },
          "criterion": {
            "type": "string"
          },
          "oracle": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "const": 0
          },
          "selected_test_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0
          },
          "resource_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "child_user_cpu_ms",
              "child_system_cpu_ms",
              "children_ru_maxrss",
              "ru_maxrss_unit"
            ],
            "properties": {
              "child_user_cpu_ms": {
                "type": "integer",
                "minimum": 0
              },
              "child_system_cpu_ms": {
                "type": "integer",
                "minimum": 0
              },
              "children_ru_maxrss": {
                "type": "integer",
                "minimum": 0
              },
              "ru_maxrss_unit": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "limitation_id",
          "state",
          "release_effect",
          "detail"
        ],
        "properties": {
          "limitation_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "release_effect": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "verdict"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "approved",
            "approved-with-minor-findings"
          ]
        }
      }
    }
  }
}
