{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefabric.local/contracts/acceptance/relational-fabric-v1/expectation.schema.json",
  "title": "CodeFabric relational fabric independent expectation corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "corpus_version",
    "status",
    "purpose",
    "owners",
    "sources",
    "global_limitations",
    "expectations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_version": {"type": "string", "minLength": 1},
    "status": {"const": "review-candidate"},
    "purpose": {"type": "string", "minLength": 1},
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/owner"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "global_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "expectations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/expectation"}
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "role", "independence_class", "accountability"],
      "properties": {
        "owner_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "independence_class": {"const": "independent-from-production-producers"},
        "accountability": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "path", "sha256", "locator", "identity"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "normative_design",
            "upstream_api",
            "released_public_contract",
            "independent_fixture",
            "security_contract",
            "toolchain_contract"
          ]
        },
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "locator": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "decoded"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "decoded": {"type": "object", "minProperties": 1}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "columns", "rows", "ordering"],
      "properties": {
        "relation": {"type": "string", "minLength": 1},
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object"}
        },
        "ordering": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal", "relations"],
      "properties": {
        "terminal": {"enum": ["pass", "reject", "unknown"]},
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/relation"}
        }
      }
    },
    "causal_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "intervention",
        "expected_discrimination",
        "unknown_passes"
      ],
      "properties": {
        "control_id": {"type": "string", "minLength": 1},
        "intervention": {"type": "string", "minLength": 1},
        "expected_discrimination": {"type": "string", "minLength": 1},
        "unknown_passes": {"const": false}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectation_id",
        "category",
        "subject",
        "query_form",
        "analysis_families",
        "owner_id",
        "rationale",
        "limitations",
        "input",
        "expected",
        "causal_controls",
        "source_refs"
      ],
      "properties": {
        "expectation_id": {"type": "string", "minLength": 1},
        "category": {
          "enum": [
            "bootstrap_model_semantics",
            "tree_sitter_exact_api",
            "ruff_exact_api",
            "pyrefly_exact_api",
            "rustc_public_exact_api",
            "rustc_private_exact_api",
            "provider_failure_remainder",
            "normalization",
            "python_derived_analysis",
            "rust_derived_analysis",
            "common_derived_analysis",
            "query_form",
            "public_lifecycle",
            "authorization_redaction",
            "hostile_rust_compilation",
            "activation_recovery",
            "legacy_revocation",
            "resource_performance"
          ]
        },
        "subject": {"type": "string", "minLength": 1},
        "query_form": {
          "type": ["string", "null"]
        },
        "analysis_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "owner_id": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "input": {"$ref": "#/$defs/input"},
        "expected": {"$ref": "#/$defs/expected"},
        "causal_controls": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/causal_control"}
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
