    "registered_before_candidate_results": true,
    "candidate_results_used": false,
    "local_relaxation_permitted": false,
    "amendment_policy": "forward-versioned-independent-review"
  },
  "statistics": {
    "warmups_per_case": 3,
    "samples_per_case": 30,
    "clock": "monotonic_ns",
    "latency_unit": "milliseconds",
    "memory_source": "operating-system-resident-set-bytes",
    "percentile_policy": {
      "name": "nearest-rank",
      "rank_expression": "max(1,ceil(percentile*sample_count))",
      "reported_percentiles": [0, 50, 95, 100]
    },
    "bootstrap": {
      "seed": 2026090150,
      "resamples": 2000,
      "confidence_percent": 95,
      "sampling": "with-replacement-same-cardinality",
      "statistics": ["median", "p95"]
    },
    "ordering": {
      "name": "deterministic-randomized-interleaved-candidate-control-blocks",
      "seed": 2026090151,
      "arms": ["candidate", "control"],
      "block_contract": "each warmup and measured block contains each arm exactly once"
    },
    "outlier_policy": "report-all-no-post-hoc-removal",
    "failure_policy": "any-timeout-crash-protocol-error-skip-or-missing-sample-fails"
  },
  "comparison": {
    "minimal_control_id": "minimal-fastmcp4-stdio-control-v1",
    "candidate_id": "installed-codefabric-fastmcp4-stdio-v1",
    "daemon_control_id": "same-candidate-direct-daemon-rpc-v1",
    "predecessor_comparison_permitted": false,
    "same_host_required": true,
    "same_power_profile_required": true,
    "semantic_equality": "canonical-json-decoded-observations-must-match-per-block",
    "different_semantics_permitted": false
  },
  "topology": {
    "candidate": "one-supervisor-one-daemon-one-launcher-and-installed-adapter-per-agent",
    "minimal_control": "one-installed-fastmcp4-stdio-process-per-agent-no-daemon",
    "daemon_control": "same-candidate-supervisor-and-daemon-with-direct-rpc-probe",
    "aggregate_rss_scope": "sum-unique-os-rss-for-every-live-process-in-the-measured-topology",
    "eight_agent_aggregate_ceiling_bytes": 1073741824,
    "eight_agent_ceiling_interpretation": "one-total-topology-ceiling-not-a-per-process-or-per-agent-ceiling",
    "concurrency_levels": [1, 2, 4, 8]
  },
  "structural_bounds": {
    "daemon_processes_per_workspace_max": 1,
    "channels_per_adapter_max": 1,
    "per_call_server_construction_max": 0,
    "per_call_channel_construction_max": 0,
    "python_sync_blocking_semantic_operations_max": 0,
    "python_arrow_decodes_max": 0,
    "python_threadpool_semantic_operations_max": 0,
    "completion_candidates_max": 100,
    "materialized_resource_pages_max": 1,
    "guard_rounds_max": 3,
    "concurrent_queries_per_agent_max": 4,
    "queued_queries_total_max": 128,
    "captured_log_bytes_max": 131072,
    "start_query_resubmissions_max": 0,
    "orphan_processes_max": 0,
    "cleanup_joined_required": true,
    "stdout_protocol_only_required": true
  },
  "environment_required_fields": [
    "recorded_at_utc",
