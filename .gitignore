# Spec section 54. Note what is deliberately NOT ignored: Cargo.lock,
# .config/nextest.toml, bacon.toml, deny.toml, _typos.toml, clippy.toml, justfile,
# generated contracts, and any reviewed snapshots. Those are the repository contract.

# Rust
/target/
/fuzz/target/
/fuzz/artifacts/
/rustc-extractor/target/
/pyrefly-sidecar/target/

# Python adapter build domain
/.venv/
/codefabric-cpg-mcp/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info

# Local diagnostics
.bacon-locations

# Profilers and generated reports that are not intentionally versioned
*.profraw
*.profdata
flamegraph.svg

# direnv (.envrc is shared; .envrc.local holds secrets such as the capability token)
.direnv/
.envrc.local

# Claude Code: settings.json and skills/ are shared, personal overrides stay local
.claude/settings.local.json

# OS / editor noise
.DS_Store
