# Spec section 54. Note what is deliberately NOT ignored: Cargo.lock, uv.lock,
# .config/nextest.toml, bacon.toml, deny.toml, _typos.toml, clippy.toml, justfile,
# py.typed, _native.pyi, and any reviewed snapshots. Those are the repository contract.

# Rust
/target/

# Python
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info

# Maturin / package output
/dist/
# `maturin develop` places the built extension in the mixed Python source tree.
/python/**/*.so
/python/**/*.pyd
/python/**/*.dylib

# Local diagnostics
.bacon-locations

# Profilers and generated reports that are not intentionally versioned
*.profraw
*.profdata
flamegraph.svg

# direnv (.envrc is shared; .envrc.local holds secrets such as the capability token)
.direnv/
.envrc.local

# Claude Code: settings.json and skills/ are shared, personal overrides stay local
.claude/settings.local.json

# OS / editor noise
.DS_Store
